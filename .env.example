# =========================================================
# APPLICATION
# =========================================================

APP_URL=https://your-domain.com

# =========================================================
# SUPABASE
# =========================================================

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Legacy fallback if your project has not migrated yet:
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxx

# =========================================================
# TELEGRAM
# =========================================================

TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=palpite10_bot

# Secret used by Telegram when calling your webhook
TELEGRAM_WEBHOOK_SECRET=change_this_to_a_long_random_string

# Channel ID, for example:
# -1001234567890
TELEGRAM_FREE_CHANNEL_ID=-1001234567890

# Public channel invite URL
TELEGRAM_FREE_CHANNEL_URL=https://t.me/your_free_channel

# Optional VIP channel URL if you manually give access.
# Leave empty if Whop manages access.
TELEGRAM_VIP_CHANNEL_URL=

# =========================================================
# DEEPSEEK
# =========================================================

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# =========================================================
# WHOP
# =========================================================

WHOP_COMPANY_API_KEY=apik_xxxxxxxxxxxxx
WHOP_WEBHOOK_SECRET=ws_xxxxxxxxxxxxx

# Optional but recommended
WHOP_COMPANY_ID=biz_xxxxxxxxxxxxx

# Your actual Whop plan IDs
WHOP_PLAN_WEEKLY=plan_xxxxxxxxx
WHOP_PLAN_MONTHLY=plan_xxxxxxxxx
WHOP_PLAN_3_MONTHS=plan_xxxxxxxxx

# false in production
WHOP_SANDBOX=false

# =========================================================
# META CONVERSIONS API
# =========================================================

META_PIXEL_ID=xxxxxxxxxxxxxxxx
META_ACCESS_TOKEN=EAABxxxxxxxxxxxxxxxx

# Example only.
# Put the current Graph API version you are using.
META_GRAPH_API_VERSION=vXX.X

# Optional while testing inside Meta Events Manager
META_TEST_EVENT_CODE=

# =========================================================
# PUBLIC VARIABLES
# =========================================================

NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_META_PIXEL_ID=xxxxxxxxxxxxxxxx
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=palpite10_bot
